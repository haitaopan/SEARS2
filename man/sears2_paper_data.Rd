\name{sears2_paper_data}
\alias{sears2_paper_defaults}
\alias{sears2_paper_scenarios}
\alias{sears2_paper_truth}
\title{Frozen SEARS 2.0 manuscript design and scenario definitions}
\description{Exported reproducibility objects containing the frozen paper defaults, the 12 scenario definitions (48 dose rows), and truth-state labels/optimized dose sets. These are simulation constructs, not empirical pediatric patient data.}
\usage{sears2_paper_defaults\nsears2_paper_scenarios\nsears2_paper_truth}
\format{\code{sears2_paper_defaults} is a named list; \code{sears2_paper_scenarios} and \code{sears2_paper_truth} are data frames.}
\examples{sears2_paper_defaults\nhead(sears2_paper_scenarios)\nsears2_paper_truth}
